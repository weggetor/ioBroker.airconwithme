{
  "name": "iobroker.airconwithme",
  "version": "1.0.0",
  "description": "Adapter for Mitsubishi aircondition with airconwithme wlan adapter",
  "author": {
    "name": "Torsten Weggen",
    "email": "weggen@bitboxx.net"
  },
  "homepage": "https://github.com/weggetor/ioBroker.airconwithme",
  "license": "MIT",
  "keywords": [
    "iobroker adapter aircondition"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/weggetor/ioBroker.airconwithme"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.3.2",
    "axios": "^1.13.2"
  },
  "devDependencies": {
    "@iobroker/testing": "^4.1.3",
    "@types/chai": "^4.3.20",
    "@types/chai-as-promised": "^7.1.8",
    "@types/gulp": "^4.0.18",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.19.54",
    "@types/proxyquire": "^1.3.31",
    "@types/sinon": "^10.0.20",
    "@types/sinon-chai": "^3.2.12",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^6.21.0",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "eslint": "^8.57.1",
    "gulp": "^5.0.1",
    "mocha": "^10.8.2",
    "proxyquire": "^2.1.3",
    "rimraf": "^5.0.10",
    "sinon": "^15.2.0",
    "sinon-chai": "^3.7.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "~5.3.3"
  },
  "main": "build/main.js",
  "scripts": {
    "prebuild": "rimraf ./build",
    "build:ts": "tsc -p tsconfig.build.json",
    "build": "npm run build:ts",
    "watch:ts": "tsc -p tsconfig.build.json --watch",
    "watch": "npm run watch:ts",
    "test:ts": "mocha --config test/mocharc.custom.json src/**/*.test.ts",
    "test:package": "mocha test/package --exit",
    "test:unit": "mocha test/unit --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:ts && npm run test:package",
    "check": "tsc --noEmit",
    "lint": "eslint --ext .ts src/",
    "translate": "gulp translateAndUpdateWordsJS"
  },
  "bugs": {
    "url": "https://github.com/weggetor/ioBroker.airconwithme/issues"
  },
  "readmeFilename": "README.md"
}
